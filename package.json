{
  "name": "echoes",
  "productName": "Echoes",
  "version": "1.0.0",
  "description": "A beautiful desktop client for YouTube Music.",
  "main": "src/main/main.js",
  "author": "Echoes contributors",
  "license": "MIT",
  "homepage": "https://github.com/heisthecat31/Echoes",
  "repository": {
    "type": "git",
    "url": "https://github.com/heisthecat31/Echoes.git"
  },
  "keywords": [
    "youtube-music",
    "electron",
    "desktop",
    "music-player"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "app": "electron-builder --dir && node scripts/run-packed.js"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.echoes.app",
    "productName": "Echoes",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "@xhayper/discord-rpc": "1.5.1"
  }
}
